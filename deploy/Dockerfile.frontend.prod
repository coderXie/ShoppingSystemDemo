# ==============================================================================
# 生产环境 Dockerfile — Vue3 前端（预编译 dist）
# 适用于 2核2G 低配服务器，不在服务器上执行 npm build
# 用法：docker build -f deploy/Dockerfile.frontend.prod -t ai-frontend .
# ==============================================================================

FROM nginx:1.27-alpine

# 移除默认配置
RUN rm /etc/nginx/conf.d/default.conf

# 复制自定义 nginx 配置
COPY deploy/nginx.conf /etc/nginx/nginx.conf

# 从构建上下文复制预编译的前端产物（需先在本地执行 npm run build）
COPY frontend/dist /usr/share/nginx/html

# 创建健康检查文件
RUN echo 'OK' > /usr/share/nginx/html/health

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
